APP_NAME="CRUD Productos"
APP_ENV=local
APP_KEY=
# En producción: APP_DEBUG=false (evita filtrar stack traces / SQL en respuestas).
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crud_productos
# Usar una cuenta de DB dedicada con privilegios mínimos (NO root, NO password vacío).
DB_USERNAME=root
DB_PASSWORD=

# Expiración de tokens Sanctum en minutos (1440 = 1 día).
SANCTUM_EXPIRATION=1440

# Credenciales del admin inicial. Fuera de local, definir SEED_ADMIN_PASSWORD
# (si se omite, el seeder genera una aleatoria y la informa por consola).
SEED_ADMIN_EMAIL=admin@demo.com
SEED_ADMIN_PASSWORD=

# CORS / Frontend
FRONTEND_URL=http://127.0.0.1:5173
VITE_API_URL=http://127.0.0.1:8000
